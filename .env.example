# Application
APP_NAME="Job Optimizer API"
APP_VERSION="0.1.0"
DEBUG=false
ENVIRONMENT=development  # development | staging | production

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/jobmatch-api
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Security — FastAPI autonomous JWT
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
API_TOKEN_EXPIRE_DAYS=30

# Better Auth (token exchange validation)
BETTER_AUTH_SECRET=same-secret-as-nextjs-better-auth
BETTER_AUTH_URL=http://localhost:3000

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Logging
LOG_DIR=logs
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR | CRITICAL

# Default AI Provider (fallback if not set per user)
DEFAULT_AI_PROVIDER=openai
DEFAULT_AI_MODEL=gpt-4o
OPENAI_API_KEY=sk-...

# File Storage
UPLOAD_DIR=uploads
MAX_CV_SIZE_MB=10
